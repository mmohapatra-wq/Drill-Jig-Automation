# Ignore Claude Code related files
.claude/
.mcp.json

# Ignore CSV files
*.csv

# Blind-evaluator judge config (secret). Eval packets now live under artifacts/,
# but keep the wildcard so a stray <model>_eval.json anywhere stays ignored.
*_eval.json
.bluegpt_judge.json

# Drill-jig index-csys export sidecar (the CSV is covered by *.csv above)
*_index_report.txt

# Machine-generated per-run artifacts: cross-tool handoffs (last_jig_spec.json,
# fastener_layout.json, hole_layout.json), probe reports, trail recipes, eval
# packets, and other throwaway diagnostics. Tools write here via
# `Join-Path $ScriptDir 'artifacts\...'`. Everything under artifacts/ is ignored
# EXCEPT the tracked .gitkeep, so the folder exists in a fresh clone (Set-Content
# fails on a missing parent dir). NOTE: ignore the CONTENTS (artifacts/*), not the
# directory itself -- excluding `artifacts/` would stop git descending into it and
# the !.gitkeep negation could never take effect.
artifacts/*
!artifacts/.gitkeep

# workflow-extraction scratch (throwaway)
.wf_extract/

# Handbook build: the bushing catalogs are needed by handbook/build.ps1 to rebuild
# the offline bundle in CI, even though *.csv is ignored above. Re-include them.
!handbook/data/
!handbook/data/*.csv

# Handbook build OUTPUT (regenerated by handbook/build.ps1 / CI -- never commit it).
handbook/dist/
